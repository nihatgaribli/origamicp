    affiliation: "Baku State University"
    email: qaribli.nihat.nemat@bsu.edu.az
repository-code: "https://github.com/nihatgaribli/origamicp"
license: MIT
keywords:
  - origami
  - crease pattern
  - identifiability
  - shape from shading
  - structured prediction
  - computer vision
